{
  "name": "sahyog-server",
  "version": "1.0.0",
  "description": "Sahyog — Societal Innovation Collaboration Portal API",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev:api": "nodemon src/server.js",
    "dev:worker": "nodemon src/worker.js",
    "start": "node src/server.js",
    "start:worker": "node src/worker.js",
    "seed": "node scripts/seed-taxonomy.js && node scripts/seed-boundaries.js && node scripts/seed-institutions.js && node scripts/seed-demo.js",
    "seed:taxonomy": "node scripts/seed-taxonomy.js",
    "seed:boundaries": "node scripts/seed-boundaries.js",
    "seed:institutions": "node scripts/seed-institutions.js",
    "seed:demo": "node scripts/seed-demo.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "bullmq": "^5.34.8",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.3",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^5.0.9",
    "openai": "^4.77.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
