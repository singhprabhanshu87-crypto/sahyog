# =============================================================================
# Sahyog — Environment variables
# Copy to .env and fill in values. Run `npm run setup` to be prompted interactively.
# =============================================================================

# ─── Core (required) ───────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173
LOG_LEVEL=debug

# ─── Database (required) ───────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/sahyog
MONGODB_DB_NAME=sahyog
MONGO_VECTOR_INDEX=submission_embeddings

# ─── Auth (required — setup auto-generates secrets) ────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
BCRYPT_ROUNDS=10

# ─── Queue (required) ──────────────────────────────────────────────────────
# Redis — local: redis://localhost:6379 | Upstash: set REDIS_TLS=true
REDIS_URL=redis://localhost:6379
REDIS_TLS=false
BULLMQ_PREFIX=sahyog
WORKER_ROLE=api

# AI — OpenAI (recommended if you have an OpenAI key)
AI_COMPLETION_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Or use OpenRouter instead (set AI_COMPLETION_PROVIDER=openrouter)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=Sahyog-Jharkhand
OPENROUTER_SITE_URL=http://localhost:5173

# OpenAI model IDs (gpt-4o-mini, gpt-4o, etc.)
AI_MODEL_TRIAGE=gpt-4o-mini
AI_MODEL_CATEGORIZE=gpt-4o-mini
AI_MODEL_SCOPE_DRAFT=gpt-4o-mini
AI_MODEL_CAPABILITY_EXTRACT=gpt-4o-mini
AI_MODEL_SUMMARIZE=gpt-4o-mini

AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
AI_CACHE_TTL_SECONDS=86400

# =============================================================================
# AI — Embeddings (dedup + matching)
# Default: local stub (no API key). Set EMBEDDING_PROVIDER=openai or jina for real vectors.
# =============================================================================
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
EMBEDDING_MODEL_VERSION=v1
TRANSFORMERS_CACHE=./.cache/models
EMBEDDING_BATCH_SIZE=16

# Only if EMBEDDING_PROVIDER=openai (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Only if EMBEDDING_PROVIDER=jina (https://jina.ai/)
JINA_API_KEY=

# ─── AI confidence thresholds ──────────────────────────────────────────────
TRIAGE_CONFIDENCE_THRESHOLD=0.75
CATEGORY_CONFIDENCE_THRESHOLD=0.70
DEDUP_SIMILARITY_THRESHOLD=0.82
DEDUP_RADIUS_METERS=500
DEDUP_TIME_WINDOW_DAYS=30
TRANSLATION_CONFIDENCE_THRESHOLD=0.60

# ─── Matching / routing ────────────────────────────────────────────────────
MATCH_SHORTLIST_SIZE=5
MATCH_FAIRNESS_WEIGHT=0.3
MATCH_CAPACITY_DEFAULT=5
CLAIM_WINDOW_HOURS=168
CLAIM_INACTIVITY_DAYS=45

# =============================================================================
# Media — Cloudinary (optional; uploads work in dev stub mode without keys)
# Get keys: https://cloudinary.com/console
# =============================================================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=
MEDIA_MAX_SIZE_MB=25
MEDIA_ALLOWED_TYPES=image/jpeg,image/png,image/webp,video/mp4,application/pdf
MEDIA_SIGNED_URL_TTL_SECONDS=900

# ─── Queue concurrency ───────────────────────────────────────────────────────
QUEUE_CONCURRENCY_INTAKE=3
QUEUE_CONCURRENCY_EMBEDDING=2
QUEUE_CONCURRENCY_DEDUP=3
QUEUE_CONCURRENCY_CLASSIFICATION=3
QUEUE_CONCURRENCY_MATCHING=2
QUEUE_CONCURRENCY_NOTIFICATIONS=10

JOB_DEFAULT_ATTEMPTS=3
JOB_BACKOFF_MS=5000
JOB_REMOVE_ON_COMPLETE=1000
JOB_REMOVE_ON_FAIL=5000

CRON_SLA_SWEEP=0 * * * *
CRON_CLAIM_RELEASE=0 2 * * *
CRON_ANALYTICS_REBUILD=0 3 * * *

# ─── Cache / rate limit ────────────────────────────────────────────────────
CACHE_PREFIX=sahyog:cache
RATE_LIMIT_STORE=memory
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_SUBMIT_MAX=5
CORS_ORIGINS=http://localhost:5173

# =============================================================================
# Language / speech (optional)
# LANGUAGE_PROVIDER: disabled | openai | bhashini
# openai uses OPENAI_API_KEY above for Whisper + translation fallback
# =============================================================================
LANGUAGE_PROVIDER=disabled
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=
BHASHINI_INFERENCE_URL=
DEFAULT_LOCALE=hi
SUPPORTED_LOCALES=en,hi,sat,ho,mun,kru

# =============================================================================
# Notifications (optional)
# =============================================================================
EMAIL_PROVIDER=disabled
RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.in
SMS_PROVIDER=disabled
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=

# ─── Geo ───────────────────────────────────────────────────────────────────
BOUNDARY_DATA_PATH=./data/jharkhand-boundaries.geojson
PUBLIC_LOCATION_PRECISION=panchayat
GEOCODING_PROVIDER=nominatim
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# ─── Integrations (optional) ───────────────────────────────────────────────
GRIEVANCE_FORWARD_ENABLED=false
GRIEVANCE_FORWARD_URL=
GRIEVANCE_FORWARD_API_KEY=

# ─── Ops (optional) ────────────────────────────────────────────────────────
SENTRY_DSN=
